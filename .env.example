# =============================================================================
# AVENIR ARENA — Environment Configuration Template
# =============================================================================

# 1. Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 2. Firebase Modular SDK Configuration (v9/v10)
# Obtain from Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=AIzaSy...your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
